VITE_PUBLIC_POSTHOG_KEY=VALUE_HERE
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

VITE_SITE_URL=http://localhost:5177

# The local app reads the shared hosted Turso Archive.
# Save a database read-only token in .env. Never use a VITE_ prefix for secrets.
ARCHIVE_ADAPTER=turso
ARCHIVE_ENVIRONMENT=local
TURSO_DATABASE_URL=libsql://saln-tracker-ph-jhoenil.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=

# Metadata lives in Turso; preserved document bytes stay in the local object store.
ARCHIVE_STORAGE=local
ARCHIVE_OBJECT_DIR=.data/objects
# Optional private Source Tips queue. Initialize it separately before enabling:
# SOURCE_TIPS_DATABASE_URL=file:.data/source-tips-preview.db
# Remote staging variables and credential roles: ops/develop.md.
