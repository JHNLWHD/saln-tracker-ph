{
  "name": "saln-tracker-ph",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "npm run dev",
    "typecheck": "react-router typegen && tsc",
    "migrate:firestore": "node migrate-to-firestore.js",
    "deploy:firestore": "firebase deploy --only firestore",
    "deploy:firestore:rules": "firebase deploy --only firestore:rules",
    "deploy:firestore:indexes": "firebase deploy --only firestore:indexes",
    "test": "node --import tsx --test tests/*.test.ts",
    "archive:migrate": "node --import tsx scripts/migrate.ts",
    "archive:import-person": "node --import tsx scripts/import-person.ts",
    "db:generate": "drizzle-kit generate",
    "archive:import-filing": "node --import tsx scripts/import-filing.ts",
    "archive:import": "node --import tsx scripts/import-manifest.ts",
    "archive:export": "node --import tsx scripts/export-snapshot.ts",
    "archive:capture-legacy": "node --import tsx scripts/legacy-capture.ts",
    "archive:audit-legacy": "node --import tsx scripts/legacy-audit.ts",
    "archive:source-tip-destination": "node --import tsx scripts/source-tip-destination.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@libsql/client": "^0.15.15",
    "@react-router/node": "^7.5.2",
    "@react-router/serve": "^7.5.2",
    "currency.js": "^2.0.4",
    "drizzle-orm": "^0.45.3",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.6.0",
    "isbot": "^5.1.27",
    "posthog-js": "^1.266.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.5.2"
  },
  "devDependencies": {
    "@netlify/vite-plugin-react-router": "^1.0.1",
    "@react-router/dev": "^7.5.2",
    "@types/node": "^20.17.32",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.11",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
